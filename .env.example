# Obligatoire : ta clé API Claude (https://console.anthropic.com)
ANTHROPIC_API_KEY=sk-ant-...

# Recommandé : mot de passe demandé dans la page (évite que des inconnus utilisent ta clé)
APP_PASSWORD=change-moi-au-moins-12-caracteres

# Optionnel
CORRECTION=0            # 1 = propose aussi la correction détaillée (coûte beaucoup plus de crédits)
RESAISIE=0              # 1 = propose aussi « re-saisir proprement » (scans, exercices retirés ; coûte des crédits)
CLAUDE_MODEL=claude-opus-5-5        # ou claude-sonnet-5-5 (moins cher, un peu moins précis)
CLAUDE_BATCH=1          # 1 = analyse en demande groupée : moitié prix, 1 à quelques minutes d'attente
CLAUDE_EFFORT=medium    # réflexion pour la correction : low, medium ou high (moins = moins cher)
CLAUDE_MAX_TOKENS=64000
MAX_UPLOAD_MB=25
WORKERS=2
MAX_PAGES=20
MAX_JOBS_PER_DAY=30      # protège tes crédits
# FORWARDED_ALLOW_IPS=*  # seulement derrière un hébergeur avec proxy (Render, Railway…)
# CHROMIUM_PATH=/chemin/vers/chrome  # seulement si Chromium n'a pas été installé par « playwright install »
